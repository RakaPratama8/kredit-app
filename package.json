{
  "name": "kredit-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "DATABASE_URL=file:./dev.db prisma migrate dev --name init",
    "db:push": "DATABASE_URL=file:./dev.db prisma db push",
    "db:seed": "DATABASE_URL=file:./dev.db node prisma/seed.js",
    "db:studio": "DATABASE_URL=file:./dev.db prisma studio",
    "test": "DATABASE_URL=file:./dev.db node prisma/test.js",
    "seed": "DATABASE_URL=file:./dev.db node prisma/seed.js",
    "setup": "DATABASE_URL=file:./dev.db prisma db push && DATABASE_URL=file:./dev.db node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "next": "16.3.6",
    "prisma": "5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "typescript": "^5"
  }
